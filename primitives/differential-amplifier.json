{
  "$schema": "./schema.json",
  "id": "differential-amplifier",
  "name": "差分放大器",
  "description": "运放差分放大：R1/Rin1将VIN1接入反相端，R2/Rin2将VIN2接入同相端，Rf跨接输出与反相端，Rg连接同相端到地/参考。",
  "role": "sensor",
  "version": "0.1.0",
  "signals": [
    {
      "id": "vcc",
      "type": "net",
      "name_pattern": "^(VCC|VDD|V\\+?|VPOS|AVCC|AVDD|VCCA|\\+5V|\\+3V3|\\+12V|PVCC|VANA)$",
      "required": true
    },
    {
      "id": "gnd",
      "type": "net",
      "name_pattern": "^(GND|PGND|AGND|DGND|VSS|VEE|V\\-?|AVSS|VNEG)$",
      "required": true
    },
    {
      "id": "in_p",
      "type": "net",
      "name_pattern": "^(IN\\+|VIN\\+|POS|VP|NON_INV|NINV|\\+IN|PLUS|AINP|VREF|V_REF|VSET).*",
      "required": true
    },
    {
      "id": "in_n",
      "type": "net",
      "name_pattern": "^(IN\\-|VIN\\-|NEG|VN|INV|\\-IN|MINUS|AINN|FB|VFB|NFB).*",
      "required": true
    },
    {
      "id": "out",
      "type": "net",
      "name_pattern": "^(V?OUT|VO|AMP_OUT|OA_OUT|OP_OUT|VOUT|VOUT1|AOUT).*",
      "required": true
    },
    {
      "id": "sig_p",
      "type": "net",
      "name_pattern": "^(SIG\\+|VIN1|VSIG1|POS_IN|ANALOG1|ADC1|V\\+IN|DIFF\\+|SENSE\\+|V_P|POS_SIG).*",
      "required": true
    },
    {
      "id": "sig_n",
      "type": "net",
      "name_pattern": "^(SIG\\-|VIN2|VSIG2|NEG_IN|ANALOG2|ADC2|V\\-IN|DIFF\\-|SENSE\\-|V_N|NEG_SIG).*",
      "required": true
    }
  ],
  "components": [
    {
      "id": "opamp",
      "type": "IC",
      "required": true,
      "pins": [
        {"number": "V+", "net": "vcc"},
        {"number": "V-", "net": "gnd"},
        {"number": "+", "net": "in_p"},
        {"number": "-", "net": "in_n"},
        {"number": "OUT", "net": "out"}
      ]
    },
    {
      "id": "R1",
      "type": "Resistor",
      "required": true,
      "pins": [
        {"number": "1", "net": "sig_p"},
        {"number": "2", "net": "in_p"}
      ]
    },
    {
      "id": "R2",
      "type": "Resistor",
      "required": true,
      "pins": [
        {"number": "1", "net": "sig_n"},
        {"number": "2", "net": "in_n"}
      ]
    },
    {
      "id": "Rf",
      "type": "Resistor",
      "required": true,
      "pins": [
        {"number": "1", "net": "out"},
        {"number": "2", "net": "in_n"}
      ]
    },
    {
      "id": "Rg",
      "type": "Resistor",
      "required": true,
      "pins": [
        {"number": "1", "net": "in_p"},
        {"number": "2", "net": "gnd"}
      ]
    }
  ],
  "constraints": {
    "min_components": 5,
    "exact_component_count": true
  },
  "scoring": {
    "weights": {
      "structural": 0.35,
      "naming": 0.25,
      "parametric": 0.15,
      "type": 0.25
    },
    "thresholds": {
      "high": 0.80,
      "medium": 0.55,
      "low": 0.0
    }
  }
}
