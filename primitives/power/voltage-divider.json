{
  "$schema": "./schema.json",
  "id": "voltage-divider",
  "name": "电压分压器",
  "description": "两电阻串联构成的分压网络：上电阻连接输入与输出，下电阻连接输出与地。",
  "role": "power",
  "version": "0.1.0",
  "signals": [
    {
      "id": "vin",
      "type": "net",
      "name_pattern": "^(VIN|VCC|VDD|VBUS|VBAT|VSYS|\\+?\\d+\\.?\\d*V|PWR).*",
      "required": true
    },
    {
      "id": "vout",
      "type": "net",
      "name_pattern": "^(VOUT|VO|VFB|FB|VSENSE|VREF|VDIV|ADC|VDET|VTH).*",
      "required": true
    },
    {
      "id": "gnd",
      "type": "net",
      "name_pattern": "^(GND|PGND|AGND|DGND|VSS)$",
      "required": true
    }
  ],
  "components": [
    {
      "id": "R_top",
      "type": "Resistor",
      "required": true,
      "pins": [
        {"number": "1", "net": "vin"},
        {"number": "2", "net": "vout"}
      ]
    },
    {
      "id": "R_bottom",
      "type": "Resistor",
      "required": true,
      "pins": [
        {"number": "1", "net": "vout"},
        {"number": "2", "net": "gnd"}
      ]
    }
  ],
  "constraints": {
    "min_components": 2,
    "exact_component_count": true
  },
  "scoring": {
    "weights": {
      "structural": 0.35,
      "naming": 0.25,
      "parametric": 0.20,
      "type": 0.20
    },
    "thresholds": {
      "high": 0.80,
      "medium": 0.50,
      "low": 0.0
    }
  },
  "design_inputs": [
    {"id": "vin", "label": "输入电压", "unit": "V"},
    {"id": "vout", "label": "输出电压", "unit": "V"},
    {"id": "r_bottom", "label": "下电阻阻值", "unit": "Ω", "default": 10000}
  ],
  "parameters": {
    "R_top.value": "(vin - vout) * r_bottom / vout",
    "R_bottom.value": "r_bottom"
  },
  "recommended_parts": {
    "R_top": [
      {"pn": "RC0603FR-07 系列 1%", "footprint": "0603"},
      {"pn": "RC0805FR-07 系列 1%", "footprint": "0805"}
    ],
    "R_bottom": [
      {"pn": "RC0603FR-07 系列 1%", "footprint": "0603"},
      {"pn": "RC0805FR-07 系列 1%", "footprint": "0805"}
    ]
  }
}
