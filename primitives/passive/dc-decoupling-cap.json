{
  "$schema": "./schema.json",
  "id": "dc-decoupling-cap",
  "name": "DC 电源去耦电容",
  "description": "电容跨接在直流电源轨（DCIN/VIN/VBUS 等）与地（GND/CGND）之间，滤除电源线上的噪声与纹波。μF 级为主滤波，nF 级为高频滤波。",
  "role": "power",
  "version": "0.2.0",
  "signals": [
    {
      "id": "power_net", "type": "net",
      "name_pattern": ".*",
      "expected_role": "power",
      "required": true
    },
    {
      "id": "gnd_net", "type": "net",
      "name_pattern": "^(GND|CGND|PGND|AGND|DGND|VSS)$",
      "required": true
    }
  ],
  "components": [
    {
      "id": "C_dec", "type": "Capacitor", "required": true,
      "pins": [
        {"number": "1", "net": "power_net"},
        {"number": "2", "net": "gnd_net"}
      ]
    }
  ],
  "constraints": {"min_components": 1, "exact_component_count": true},
  "scoring": {
    "weights": {"structural": 0.30, "naming": 0.40, "parametric": 0.10, "type": 0.20},
    "thresholds": {"high": 0.80, "medium": 0.55, "low": 0.0}
  }
}
