{
  "$schema": "./schema.json",
  "id": "pull-up-resistor",
  "name": "上拉电阻",
  "description": "电阻一端接电源（role=power），另一端接数字信号（role=digital），将信号默认拉到高电平。",
  "role": "unknown",
  "version": "0.2.0",
  "signals": [
    {
      "id": "vcc",
      "type": "net",
      "name_pattern": "^(VCC|VDD|VBUS|\\+?\\d+\\.?\\d*V|\\+?\\d+V\\d+|3V3|5V).*",
      "expected_role": "power",
      "required": true,
      "expected_pin_category": "power_in",
      "pin_category_fallback": true
    },
    {
      "id": "signal",
      "type": "net",
      "name_pattern": ".*",
      "required": true
    }
  ],
  "components": [
    {
      "id": "R_pull",
      "type": "Resistor",
      "required": true,
      "value_pattern": "^\\d+(\\.\\d+)?\\s*[kK]",
      "pins": [
        {
          "number": "1",
          "net": "vcc"
        },
        {
          "number": "2",
          "net": "signal"
        }
      ]
    }
  ],
  "constraints": {
    "min_components": 1,
    "exact_component_count": true
  },
  "scoring": {
    "weights": {
      "structural": 0.2,
      "naming": 0.2,
      "parametric": 0.2,
      "type": 0.4
    },
    "thresholds": {
      "high": 0.8,
      "medium": 0.55,
      "low": 0.0
    }
  }
}
