{
  "$schema": "./schema.json",
  "id": "led-driver-switch",
  "name": "LED 驱动低边开关",
  "description": "NPN 三极管发射极接地、集电极接负载，基极经限流电阻接 MCU 数字信号。控制信号为高电平时三极管导通，负载（LED 等）得电。",
  "role": "digital",
  "version": "0.2.0",
  "signals": [
    {
      "id": "ctrl",
      "type": "net",
      "name_pattern": ".*LED\\d+.*",
      "required": true
    },
    {
      "id": "mid_net",
      "type": "net",
      "name_pattern": ".*",
      "required": true
    },
    {
      "id": "load_net",
      "type": "net",
      "name_pattern": ".*",
      "required": true
    },
    {
      "id": "gnd",
      "type": "net",
      "name_pattern": "^(GND|PGND|AGND|DGND|VSS)$",
      "required": true
    },
    {
      "id": "load_mid",
      "type": "net",
      "name_pattern": ".*",
      "required": false
    },
    {
      "id": "load_rail",
      "type": "net",
      "name_pattern": "^(USB_5V|VCC.*|VDD.*|\\+?\\d+(\\.\\d+)?V|5V\\d*|3V\\d*|VBUS.*|DCIN.*)$",
      "required": false
    }
  ],
  "components": [
    {
      "id": "Q1",
      "type": [
        "Mosfet",
        "Unknown"
      ],
      "required": true,
      "pin_count_max": 6,
      "pins": [
        {
          "number": "B",
          "net": "mid_net"
        },
        {
          "number": "E",
          "net": "gnd"
        },
        {
          "number": "C",
          "net": "load_net"
        }
      ]
    },
    {
      "id": "R_base",
      "type": "Resistor",
      "required": true,
      "value_pattern": "^\\d+(\\.\\d+)?\\s*[kK]",
      "pins": [
        {
          "number": "1",
          "net": "ctrl"
        },
        {
          "number": "2",
          "net": "mid_net"
        }
      ]
    },
    {
      "id": "R_pd",
      "type": "Resistor",
      "required": false,
      "pins": [
        {
          "number": "1",
          "net": "gnd"
        },
        {
          "number": "2",
          "net": "mid_net"
        }
      ]
    },
    {
      "id": "R_load",
      "type": "Resistor",
      "required": false,
      "optional_group": "load",
      "value_pattern": "^\\d+(?:\\.\\d+)?\\s*[RΩkK]",
      "strict_value": false,
      "title": "LED 限流电阻",
      "pins": [
        {
          "number": "1",
          "net": "load_mid"
        },
        {
          "number": "2",
          "net": "load_rail"
        }
      ]
    },
    {
      "id": "J_load",
      "type": "Connector",
      "required": false,
      "optional_group": "load",
      "title": "{kind} {value}",
      "pins": [
        {
          "number": "1",
          "net": "load_mid"
        },
        {
          "number": "2",
          "net": "load_net"
        }
      ]
    }
  ],
  "constraints": {
    "min_components": 2,
    "exact_component_count": false
  },
  "scoring": {
    "weights": {
      "structural": 0.4,
      "naming": 0.3,
      "parametric": 0.1,
      "type": 0.2
    },
    "thresholds": {
      "high": 0.8,
      "medium": 0.55,
      "low": 0.0
    }
  }
}
